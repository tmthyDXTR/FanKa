# Set a long, random value and keep it secret — it signs login access tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=key

# Set to "production" when deployed (enables secure cookies, disables the dev JWT_SECRET fallback).
NODE_ENV=production

# Optional: override where the SQLite database file is stored.
# DB_PATH=/home/youruser/flashcards-data/flashcards.db

# Optional AI card generation (OpenAI-compatible chat completions API).
# Choose a provider/base URL and model; API keys stay on the server.
# OpenRouter provides models with free-tier availability; select a currently
# available free model in its catalog. Other compatible services can be swapped in.
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-provider-api-key
# LLM_MODEL=your-provider-model-id
# For a local OpenAI-compatible server such as LM Studio:
# LLM_API_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-loaded-local-model
